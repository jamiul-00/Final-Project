<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12"
      prefWidth="600" prefHeight="550"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.group_project_autumn_26.StoreManager.Controller.SearchProductController">

    <Label text="Search Product"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TextField fx:id="searchField"
               promptText="Enter Product ID or Product Name"
               maxWidth="300"/>

    <Button text="Search"
            onAction="#searchProduct"/>

    <Label text="Product ID:"/>
    <Label fx:id="productIdLabel" text="-"/>

    <Label text="Product Name:"/>
    <Label fx:id="productNameLabel" text="-"/>

    <Label text="Size:"/>
    <Label fx:id="sizeLabel" text="-"/>

    <Label text="Price:"/>
    <Label fx:id="priceLabel" text="-"/>

    <Label text="Quantity:"/>
    <Label fx:id="quantityLabel" text="-"/>

    <Label fx:id="messageLabel" text=""/>

    <Button text="Back to Dashboard"
            onAction="#backToDashboard"/>

</VBox>
