<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12"
      prefWidth="600" prefHeight="550"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.group_project_autumn_26.StoreManager.Controller.UpdateProductController">

    <Label text="Update Product"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TextField fx:id="productIdField"
               promptText="Enter Product ID" maxWidth="300"/>

    <Button text="Find Product"
            onAction="#findProduct"/>

    <Label text="Product Name:"/>
    <Label fx:id="productNameLabel" text="-"/>

    <TextField fx:id="sizeField"
               promptText="Updated Size" maxWidth="300"/>

    <TextField fx:id="priceField"
               promptText="Updated Price" maxWidth="300"/>

    <TextField fx:id="quantityField"
               promptText="Updated Quantity" maxWidth="300"/>

    <Button text="Update Product"
            onAction="#updateProduct"/>

    <Label fx:id="messageLabel" text=""/>

    <Button text="Back to Dashboard"
            onAction="#backToDashboard"/>

</VBox>
