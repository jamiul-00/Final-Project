<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="710.0" prefWidth="854.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.group_project_autumn_26.CustomerDashboardController">
   <children>
      <Label fx:id="customerDashboardLabel" alignment="CENTER" blendMode="DARKEN" layoutX="325.0" prefHeight="29.0" prefWidth="205.0" text="Bata Shoe Customer Dashboard" textFill="#bc0d0d" wrapText="true">
         <effect>
            <Blend />
         </effect>
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Label layoutX="48.0" layoutY="37.0" text="Search Shoes:" />
      <TextField fx:id="searchShoesTF" layoutX="132.0" layoutY="33.0" />
      <ComboBox fx:id="categoryCB" layoutX="132.0" layoutY="74.0" prefWidth="150.0" />
      <Label layoutX="59.0" layoutY="78.0" text="Category:" />
      <ComboBox fx:id="genderCB" layoutX="132.0" layoutY="123.0" prefWidth="150.0" />
      <Label layoutX="64.0" layoutY="127.0" text="Gender:" />
      <Button layoutX="290.0" layoutY="160.0" mnemonicParsing="false" onAction="#searchFilterButtonOA" text="Filter" />
      <TableView fx:id="shoesTableView" layoutX="54.0" layoutY="196.0" prefHeight="200.0" prefWidth="375.0">
        <columns>
          <TableColumn fx:id="idTC" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="shoeNameTC" prefWidth="100.0" text="Shoe Name" />
            <TableColumn fx:id="categoryTC" prefWidth="50.0" text="Category" />
            <TableColumn fx:id="genderTC" prefWidth="75.0" text="Gender" />
            <TableColumn fx:id="priceTC" prefWidth="75.0" text="price" />
        </columns>
      </TableView>
      <ComboBox fx:id="sizeCB" layoutX="121.0" layoutY="412.0" prefWidth="150.0" />
      <Label layoutX="79.0" layoutY="416.0" text="Size:" />
      <Button layoutX="354.0" layoutY="475.0" mnemonicParsing="false" onAction="#addToCartButtonOA" text="Add To Cart">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Button layoutX="469.0" layoutY="33.0" mnemonicParsing="false" onAction="#myCartButtonOA" text="My Cart">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Button layoutX="550.0" layoutY="33.0" mnemonicParsing="false" onAction="#myOrdersButtonOA" text="My Orders">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Button blendMode="DARKEN" layoutX="637.0" layoutY="33.0" mnemonicParsing="false" onAction="#returnAndReviewButtonOA" text="Return &amp; Review">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Button blendMode="DARKEN" layoutX="758.0" layoutY="33.0" mnemonicParsing="false" onAction="#logoutButtonOA" text="LogOut">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Label layoutX="333.0" layoutY="416.0" text="Quantity:" />
      <TextField fx:id="quantityTF" layoutX="388.0" layoutY="412.0" />
   </children>
</AnchorPane>
